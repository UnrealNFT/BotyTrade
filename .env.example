# Telegram (bot AIOud — envoie ALERTES/TRADES/SIGNAUX dans ce chat)
# 
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=-1003....3264
TELEGRAM_AUTHORIZED_USERNAME=@username

# Solana
SOLANA_PRIVATE_KEY=your_base58_private_key
SOLANA_PUBLIC_KEY=your_public_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Trading
PAPER_TRADING=true
MAX_DAILY_LOSS_USD=50
MAX_POSITION_PCT=0.10
DEFAULT_SL_PCT=0.05
DEFAULT_TP1_PCT=0.03
DEFAULT_TP2_PCT=0.06
DEFAULT_TP3_PCT=0.12
TRADING_AMOUNT_USD=10
PRIORITY_FEE_MICRO_LAMPORTS=0
MIN_SOL_BALANCE_FOR_FEES=0.02
MIN_USDC_BALANCE_TO_TRADE=0.50
BALANCE_ALERT_COOLDOWN_MINUTES=30

# Data
JUPITER_API_URL=https://quote-api.jup.ag/v6
MORALIS_API_KEY=your_moralis_key

# Groq
GROQ_API_KEY=your_groq_key

# Piranewz (news feed for LLM context — LECTURE SEULE via API HTTP)
# The Telegram channel listener is DISABLED by default to avoid conflicts with AIOud's bot.
# Provide PIRANEWZ_API_URL to fetch news/sentiment from the external Piranewz service.
# PIRANEWZ_API_KEY is optional if the HTTP API requires authentication.
PIRANEWZ_API_URL=
PIRANEWZ_API_KEY=
PIRANEWZ_CHANNEL=@PIRANEWZ
# Optional comma-separated tickers to always detect (e.g. PIRANEWZ_EXTRA_TICKERS=CHONK,MYRO,WEN)
PIRANEWZ_EXTRA_TICKERS=

# Multi-asset manual signals (CEX: MEXC, Kraken, CoinGecko, CoinMarketCap)
# MANUAL_SIGNAL_ENABLED=true generates buy-limit/TP/SL signals for non-Solana tokens.
MANUAL_SIGNAL_ENABLED=true
MANUAL_SIGNAL_MIN_CONFIDENCE=50
COINGECKO_API_KEY=your_coingecko_demo_key
COINMARKETCAP_API_KEY=your_cmc_key

# Logging
LOG_LEVEL=INFO
